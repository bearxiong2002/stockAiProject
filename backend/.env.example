# StockPanel 数据源配置示例（复制为 backend/.env 并填入真实值；.env 已被 .gitignore 忽略）
# 环境变量优先级高于本文件。密钥只放请求头，不要写进源码、日志或前端。

# 数据源模式: mock（默认，离线模拟）/ datahubco / promax / hybrid（按接口路由主备源）
STOCK_DATA_MODE=hybrid

# Datahubco 基础版: 已支持 HTTPS（旧的 http:// 地址会被 301 重定向，导致“响应非 JSON”）
DATAHUBCO_BASE_URL=https://datahubco.com/app-api/openapi/v1/tushare
DATAHUBCO_API_KEY=replace-with-your-datahubco-key
# 仅当 DATAHUBCO_BASE_URL 使用 http:// 时才需要显式允许
DATAHUBCO_ALLOW_HTTP=false

# ProMax Relay: https://pcd.mobcvb.cn/tushare/pro（HTTPS）
PROMAX_BASE_URL=https://pcd.mobcvb.cn/tushare/pro
PROMAX_API_KEY=replace-with-your-promax-key

# ---------------------------------------------------------------------------
# LLM / AI 分析（可选；不配置时报告降级为纯算法，权重 50/50）
# 也可在设置页配置（写入 SQLite config 表并加密存储，设置页优先级更高）。
# ---------------------------------------------------------------------------
# claude / openai / custom / none
LLM_PROVIDER=none
# Claude: https://console.anthropic.com  OpenAI: https://platform.openai.com
LLM_API_KEY=
# 留空使用默认: claude=https://api.anthropic.com  openai=https://api.openai.com/v1
LLM_API_BASE=
# 留空使用默认模型（设置页可查看建议列表）
LLM_MODEL=

# ---------------------------------------------------------------------------
# MySQL 数据库（填好 MYSQL_HOST 后启用；留空则回退本地 SQLite）
# 目标库不存在时启动会自动 CREATE DATABASE（需账号有建库权限，否则请手动建库）
# ---------------------------------------------------------------------------
# 数据库地址（IP 或域名），例如 127.0.0.1 或 192.168.1.100
MYSQL_HOST=
# 端口，默认 3306
MYSQL_PORT=3306
# 用户名 / 密码（密码含 @ : / 等特殊字符无需转义，代码会处理）
MYSQL_USER=root
MYSQL_PASSWORD=
# 库名（首次启动自动创建，字符集 utf8mb4）
MYSQL_DATABASE=stockpanel

# 高级: 完整连接串覆盖以上所有项（可选）
# STOCKPANEL_DB_URL=mysql+aiomysql://user:pass@host:3306/stockpanel?charset=utf8mb4

# ---------------------------------------------------------------------------
# 生产部署（可选）: 前端 npm run build 后，FastAPI 自动托管 frontend/dist
# ---------------------------------------------------------------------------
# STOCKPANEL_SERVE_STATIC=true
# STOCKPANEL_FRONTEND_DIST=../frontend/dist
